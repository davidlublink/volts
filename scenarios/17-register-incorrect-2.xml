<!-- Test label as username causes test to fail -->
<config>
    <actions>
        <action type="register" label="Register {{ a.alice.label }} with bad auth name"
            transport="{{ a.alice.transport }}"
            account="{{ a.alice.username }}"
            username="{{ a.alice.username }}"
            auth_username="{{ a.alice.label }}"
            password="{{ a.alice.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.alice.domain }}"
            expected_cause_code="401"
        />
        <action type="wait" complete="true" ms="2000"/>
    </actions>
</config>
