<!-- Register bob and alice. Call queue 11(which has alice as a member) which transfers to a queue that has Bob has a number -->
<config>
    <actions>
        <action type="codec" disable="all"/>
        <action type="codec" enable="pcma" priority="250"/>
        <action type="codec" enable="pcmu" priority="249"/>
        <action type="codec" enable="opus" priority="248"/>

        <action type="register" label="Register {{ a.alice.label }}"
            transport="{{ a.alice.transport }}"
            account="{{ a.alice.username }}"
            username="{{ a.alice.username }}"
            auth_username="{{ a.alice.auth_username }}"
            password="{{ a.alice.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.alice.domain }}"
            expected_cause_code="200"
            srtp="{{ a.alice.srtp }}"
        />
        <action type="wait" complete="true" ms="2000" label="Wait for registration to propagate"/>
        <action type="register" label="Register {{ a.bob.label }}"
            transport="{{ a.bob.transport }}"
            account="{{ a.bob.username }}"
            username="{{ a.bob.username }}"
            auth_username="{{ a.bob.auth_username }}"
            password="{{ a.bob.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.bob.domain }}"
            expected_cause_code="200"
            srtp="{{ a.bob.srtp }}"
        />
        <action type="wait" complete="true" ms="2000" label="Wait for registration to propagate"/>

        <action type="wait" complete="true"/>

        <action type="call" label="Call from {{ a.bob.label }} to {{ a.queue11.label }}"
            transport="{{ a.bob.transport }}"
            expected_cause_code="200"
            caller="{{ a.bob.username }}@{{ a.bob.domain }}"
            callee="{{ a.queue11.get('extension', a.queue11.username) }}@{{ a.queue11.domain }}"
            from="sip:{{ a.bob.username }}@{{ a.bob.domain }}"
            to_uri="{{ a.queue11.get('extension', a.queue11.username) }}@{{ a.queue11.domain }}"
            max_duration="20" hangup="10"
            auth_username="{{ a.bob.username }}"
            password="{{ a.bob.password }}"
            realm="{{ a.bob.domain }}"
            rtp_stats="true"
            max_ring_duration="15"
            srtp="{{ a.bob.srtp }}"
            play="{{ c.play_file }}"
            rtp_port_min="5000"
            rtp_port_max="6000"
        />

        <!-- alice should NOT receive the call -->
        <action type="accept" label="Receive call on {{ a.alice.label }}"
            match_account="{{ a.alice.username }}"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.alice.transport }}"
            srtp="{{ a.alice.srtp }}"
            fail_on_accept="true"
            expected_cause_code="487"
        />
        <!-- bob should receive the call -->
        <action type="accept" label="Receive call on {{ a.bob.label }}"
            match_account="{{ a.bob.username }}"
            call_count="1"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.bob.transport }}"
            play="{{ c.play_file }}"
            srtp="{{ a.bob.srtp }}"
        />
        
        <action type="wait" complete="true" ms="20000"/>
    </actions>
</config>
