<!-- Register 2 accounts with 90002 AOR and receive a call from 90001 on both -->
<config>
    <actions>
        <action type="register" label="Register {{ a.alice.label }}-1"
            transport="{{ a.alice.transport }}"
            account="{{ a.alice.username }}-1"
            username="{{ a.alice.username }}"
            auth_username="{{ a.alice.auth_username }}"
            password="{{ a.alice.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.alice.domain }}"
            expected_cause_code="200"
        />

        <action type="register" label="Register a second time {{ a.alice.label }}-2, see two contacts "
            transport="{{ a.alice.transport }}"
            account="{{ a.alice.username }}-2"
            username="{{ a.alice.username }}"
            auth_username="{{ a.alice.auth_username }}"
            password="{{ a.alice.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.alice.domain }}"
            expected_cause_code="200"
        />

        <action type="wait" complete="true" ms="2000"/>
        <action type="accept" label="Receive call on {{ a.alice.label }}-1 (CANCEL)"
            call_count="1"
            match_account="{{ a.alice.username }}-1"
            ring_duration="30"
            cancel="force"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.alice.transport }}"
            srtp="{{ a.alice.srtp }}"
            play="{{ c.play_file }}"
        />
        <action type="accept" label="Receive call on {{ a.alice.label }}-2 (OK)"
            call_count="1"
            match_account="{{ a.alice.username }}-2"
            hangup="10"
            ring_duration="5"
            code="200" reason="OK"
            transport="{{ a.alice.transport }}"
            srtp="{{ a.alice.srtp }}"
            play="{{ c.play_file }}"
        />
        <action type="call" label="Call {{ a.bob.label }} -> {{ a.alice.label }} (2 accounts)"
            transport="{{ a.bob.transport }}"
            expected_cause_code="200"
            caller="{{ a.bob.username }}@{{ a.bob.domain }}"
            callee="{{ a.alice.username }}@{{ a.bob.domain }}"
            from="sip:{{ a.bob.username }}@{{ a.bob.domain }}"
            to_uri="{{ a.alice.username }}@{{ a.alice.domain }}"
            max_duration="20" hangup="10"
            auth_username="{{ a.bob.username }}"
            password="{{ a.bob.password }}"
            realm="{{ a.bob.domain }}"
            rtp_stats="true"
            max_ring_duration="15"
            srtp="{{ a.bob.srtp }}"
            play="{{ c.play_file }}"
        />
        <action type="wait" complete="true" ms="30000"/>
    </actions>
</config>
