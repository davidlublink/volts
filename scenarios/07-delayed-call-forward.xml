<!-- Register with Alice and Chuck. Bob makes a call to Chuck, Chuck's device rings 30 seconds, no answer and the call is forwarded to Alice who answers -->
<config>
    <actions>
        <action type="codec" disable="all"/>
        <action type="codec" enable="pcma" priority="250"/>
        <action type="codec" enable="pcmu" priority="249"/>
        <action type="codec" enable="opus" priority="248"/>
        <action type="register" label="Register {{ a.alice.label }}"
            transport="{{ a.alice.transport }}"
            account="{{ a.alice.username }}"
            username="{{ a.alice.username }}"
            auth_username="{{ a.alice.auth_username }}"
            password="{{ a.alice.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.alice.domain }}"
            expected_cause_code="200"
            srtp="{{ a.alice.srtp }}"
        />

        <action type="register" label="Register {{ a.chuck.label }}"
            transport="{{ a.chuck.transport }}"
            account="{{ a.chuck.username }}"
            username="{{ a.chuck.username }}"
            auth_username="{{ a.chuck.auth_username }}"
            password="{{ a.chuck.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.chuck.domain }}"
            expected_cause_code="200"
            srtp="{{ a.chuck.srtp }}"
        />

        <action type="wait" complete="true" ms="2000"/>

        <action type="call" label="Call from {{ a.bob.label }} to {{ a.chuck.label }}->{{ a.alice.label }}"
            transport="{{ a.bob.transport }}"
            expected_cause_code="200"
            caller="{{ a.bob.username }}@{{ a.bob.domain }}"
            callee="{{ a.chuck.get('extension', a.chuck.username) }}@{{ a.chuck.domain }}"
            from="sip:{{ a.bob.username }}@{{ a.bob.domain }}"
            to_uri="{{ a.chuck.get('extension', a.chuck.username) }}@{{ a.chuck.domain }}"
            max_duration="20" hangup="10"
            auth_username="{{ a.bob.username }}"
            password="{{ a.bob.password }}"
            realm="{{ a.bob.domain }}"
            rtp_stats="true"
            max_ring_duration="60"
            srtp="{{ a.bob.srtp }}"
            play="{{ c.play_file }}"
            rtp_port_min="5000"
            rtp_port_max="6000"
        />

        <action type="accept" label="Receive, and don't answer, call on {{ a.chuck.label }}"
            match_account="{{ a.chuck.username }}"
            call_count="1"
            hangup="10"
            ring_duration="30"
            cancel="force"
            transport="{{ a.chuck.transport }}"
            srtp="{{ a.chuck.srtp }}"
        />
        <action type="accept" label="Receive, and answer, call on {{ a.alice.label }}"
            match_account="{{ a.alice.username }}"
            call_count="1"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.alice.transport }}"
            srtp="{{ a.alice.srtp }}"
            play="{{ c.play_file }}"
        />
        <action type="wait" complete="true" ms="20000"/>
    </actions>
</config>
