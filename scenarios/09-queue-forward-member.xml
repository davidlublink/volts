<!-- Register with 90002, make a call to queue 91502
queue 91502 has a single member 91002, which is forwarded to 90002, but this fowrard should not happen cause it's queue member -->

<!-- Register with Carol, Bob calls a queue with single member Carol. Carol's call forwarding is ignored because it's a queue member and the call rings to Carol who answers-->
<config>
    <actions>
        <action type="codec" disable="all"/>
        <action type="codec" enable="pcma" priority="{{ c.pcma_priority }}"/>
        <action type="codec" enable="pcmu" priority="{{ c.pcmu_priority }}"/>
        <action type="codec" enable="opus" priority="{{ c.opus_priority }}"/>
        <action type="register" label="Register {{ a.carol.label }}"
            transport="{{ a.carol.transport }}"
            account="{{ a.carol.username }}"
            username="{{ a.carol.username }}"
            auth_username="{{ a.carol.auth_username }}"
            password="{{ a.carol.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.carol.domain }}"
            expected_cause_code="200"
            srtp="{{ a.carol.srtp }}"
        />
        <action type="wait" complete="true" ms="2000" label="{{ a.carol.label }} Wait for registration to propagate"/>
        <action type="accept" label="Receive call from {{ a.bob.label }} via queue"
            call_count="1"
            match_account="{{ a.carol.username }}"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.carol.transport }}"
            srtp="{{ a.carol.srtp }}"
            play="{{ c.play_file }}"
            rtp_stats="true"
         />

        <action type="call" label="Call from {{ a.bob.label }} to {{ a.queue09.label }}"
            transport="{{ a.bob.transport }}"
            expected_cause_code="200"
            caller="{{ a.bob.username }}@{{ a.bob.domain }}"
            callee="{{ a.queue09.get('extension', a.queue09.username) }}@{{ a.queue09.domain }}"
            from="sip:{{ a.bob.username }}@{{ a.bob.domain }}"
            to_uri="{{ a.queue09.get('extension', a.queue09.username) }}@{{ a.queue09.domain }}"
            max_duration="20" hangup="10"
            auth_username="{{ a.bob.username }}"
            password="{{ a.bob.password }}"
            realm="{{ a.bob.domain }}"
            rtp_stats="true"
            max_ring_duration="15"
            srtp="{{ a.bob.srtp }}"
            play="{{ c.play_file }}"
            rtp_port_min="5000"
            rtp_port_max="6000"
        />
        <action type="wait" complete="true" ms="30000" label="Wait for call completion"/>
    </actions>
</config>
