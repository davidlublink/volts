<!-- Register with alice and receive call on it from bob using ## prefix -->
<config>
    <actions>
        <action type="codec" disable="all"/>
        <action type="codec" enable="pcma" priority="{{ c.pcma_priority }}"/>
        <action type="codec" enable="pcmu" priority="{{ c.pcmu_priority }}"/>
        <action type="codec" enable="opus" priority="{{ c.opus_priority }}"/>
        <action type="register" label="Register {{ a.alice.label }}"
            transport="{{ a.alice.transport }}"
            account="{{ a.alice.username }}"
            username="{{ a.alice.username }}"
            auth_username="{{ a.alice.auth_username }}"
            password="{{ a.alice.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.alice.domain }}"
            expected_cause_code="200"
            srtp="{{ a.alice.srtp }}"
        />
        <action type="wait" complete="true" ms="2000" label="Wait for registration to propagate"/>
        <action type="accept" label="Receive call from {{ a.alice.label }}"
            call_count="1"
            match_account="{{ a.alice.username }}"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.alice.transport }}"
            srtp="{{ a.alice.srtp }}"
            play="{{ c.play_file }}"
            rtp_stats="true"
         />

        <action type="call" label="Call from {{ a.bob.label }} to {{ a.alice.label }} via ##{{ a.alice.get('extension', a.alice.username) }}"
            transport="{{ a.bob.transport }}"
            expected_cause_code="200"
            caller="{{ a.bob.username }}@{{ c.domain }}"
            callee="##{{ a.alice.get('extension', a.alice.username) }}@{{ a.alice.domain }}"
            from="sip:{{ a.bob.username }}@{{ c.domain }}"
            to_uri="##{{ a.alice.get('extension', a.alice.username) }}@{{ c.domain }}"
            max_duration="20" hangup="10"
            auth_username="{{ a.bob.username }}"
            password="{{ a.bob.password }}"
            realm="{{ c.domain }}"
            rtp_stats="true"
            max_ring_duration="15"
            srtp="{{ a.bob.srtp }}"
            play="{{ c.play_file }}"
            rtp_port_min="5000"
            rtp_port_max="6000"
        />
        <action type="wait" complete="true" ms="30000" label="Wait for call completion"/>
    </actions>
</config>
