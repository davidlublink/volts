<!-- Register with bob and receive call on it from alice -->
<!-- This is sanity to ensure bob receives calls since later tests assume he does -->
<config>
    <actions>
        <action type="codec" disable="all"/>
        <action type="codec" enable="pcma" priority="{{ c.pcma_priority }}"/>
        <action type="codec" enable="pcmu" priority="{{ c.pcmu_priority }}"/>
        <action type="codec" enable="opus" priority="{{ c.opus_priority }}"/>
        <action type="register" label="Register {{ a.bob.label }}"
            transport="{{ a.bob.transport }}"
            account="{{ a.bob.username }}"
            username="{{ a.bob.username }}"
            auth_username="{{ a.bob.auth_username }}"
            password="{{ a.bob.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.bob.domain }}"
            expected_cause_code="200"
            srtp="{{ a.bob.srtp }}"
        />
        <action type="wait" complete="true" ms="2000" label="Wait for registration to propagate"/>
        <action type="accept" label="Receive call from {{ a.bob.label }}"
            call_count="1"
            match_account="{{ a.bob.username }}"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.bob.transport }}"
            srtp="{{ a.bob.srtp }}"
            play="{{ c.play_file }}"
            rtp_stats="true"
         />

        <action type="call" label="Call from {{ a.alice.label }} to {{ a.bob.label }}"
            transport="{{ a.alice.transport }}"
            expected_cause_code="200"
            caller="{{ a.alice.username }}@{{ a.alice.domain }}"
            callee="{{ a.bob.get('extension', a.bob.username) }}@{{ a.bob.domain }}"
            from="sip:{{ a.alice.username }}@{{ a.alice.domain }}"
            to_uri="{{ a.bob.get('extension', a.bob.username) }}@{{ a.bob.domain }}"
            max_duration="20" hangup="10"
            auth_username="{{ a.alice.username }}"
            password="{{ a.alice.password }}"
            realm="{{ a.alice.domain }}"
            rtp_stats="true"
            max_ring_duration="15"
            srtp="{{ a.alice.srtp }}"
            play="{{ c.play_file }}"
            rtp_port_min="5000"
            rtp_port_max="6000"
        />
        <action type="wait" complete="true" ms="30000" label="Wait for call completion"/>
    </actions>
</config>
