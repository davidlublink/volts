<!-- Register with as queue10, make a call to queue queue10, where queue10 is the only member 
Make sure that queue could hold endpoints with same numbers as queue itself -->
<config>
    <actions>
        <action type="codec" disable="all"/>
        <action type="codec" enable="pcma" priority="{{ c.pcma_priority }}"/>
        <action type="codec" enable="pcmu" priority="{{ c.pcmu_priority }}"/>
        <action type="codec" enable="opus" priority="{{ c.opus_priority }}"/>
        <action type="register" label="Register {{ a.user10.label }}"
            transport="{{ a.user10.transport }}"
            account="{{ a.user10.username }}"
            username="{{ a.user10.username }}"
            auth_username="{{ a.user10.auth_username }}"
            password="{{ a.user10.password }}"
            registrar="{{ c.domain }}"
            realm="{{ a.user10.domain }}"
            expected_cause_code="200"
            srtp="{{ a.user10.srtp }}"
        />
        <action type="wait" complete="true" ms="2000" label="Wait for registration to propagate"/>
        <action type="accept" label="Receive call from {{ a.bob.label }}"
            call_count="1"
            match_account="{{ a.user10.username }}"
            hangup="10"
            code="200" reason="OK"
            transport="{{ a.user10.transport }}"
            srtp="{{ a.user10.srtp }}"
            play="{{ c.play_file }}"
            rtp_stats="true"
         />

        <action type="call" label="Call from {{ a.bob.label }} to {{ a.queue10.label }}"
            transport="{{ a.bob.transport }}"
            expected_cause_code="200"
            caller="{{ a.bob.username }}@{{ a.bob.domain }}"
            callee="{{ a.queue10.get('extension', a.queue10.username) }}@{{ a.queue10.domain }}"
            from="sip:{{ a.bob.username }}@{{ a.bob.domain }}"
            to_uri="{{ a.queue10.get('extension', a.queue10.username) }}@{{ a.queue10.domain }}"
            max_duration="20" hangup="10"
            auth_username="{{ a.bob.username }}"
            password="{{ a.bob.password }}"
            realm="{{ a.bob.domain }}"
            rtp_stats="true"
            max_ring_duration="15"
            srtp="{{ a.bob.srtp }}"
            play="{{ c.play_file }}"
            rtp_port_min="5000"
            rtp_port_max="6000"
        />
        <action type="wait" complete="true" ms="30000" label="Wait for call completion"/>
    </actions>
</config>
